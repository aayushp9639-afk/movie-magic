# ==============================================================================
# Movie Magic — Application Environment Configuration Template
# NOTE: Copy this file to '.env' for local development. Never commit '.env'.
# ==============================================================================

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-insecure-secret-key-change-in-production-movie-magic-2026

# Application Settings
APP_NAME=Movie Magic
APP_PORT=5000
APP_HOST=127.0.0.1
DEFAULT_CITY=Kolhapur

# Session Security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Optional TMDB (The Movie Database) Metadata API Configuration
# Movie Magic functions completely without an API key using the curated local seed catalogue.
# If you wish to query the TMDB API for live metadata enrichment:
# 1. Register for a free account at https://www.themoviedb.org/
# 2. Generate an API Key under Settings > API
# 3. Paste your v3 API Key below:
TMDB_API_KEY=

# AWS Integration Settings (Phase 2: ap-south-1 Mumbai)
# Default region: ap-south-1 (Mumbai, India)
AWS_REGION=ap-south-1

# Standard AWS Credential Chain:
# When USE_AWS_MOCK=False, boto3 automatically discovers credentials from:
# 1. Environment variables (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below)
# 2. Shared credentials file (~/.aws/credentials) or AWS CLI profile
# 3. IAM Role for Amazon EC2 (when deployed on AWS)
# Leave blank to use default credential chain or IAM role. Never commit secrets.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB Configuration
DYNAMODB_TABLE_PREFIX=moviemagic_
# Optional endpoint URL for local DynamoDB container (e.g. http://localhost:8000)
DYNAMODB_ENDPOINT_URL=

# Amazon SNS Configuration
SNS_BOOKING_TOPIC_ARN=

# Resend Transactional Email Configuration (Customer Welcome & Booking Confirmation)
# Sign up at https://resend.com and add/verify your domain (e.g. mail.shardul.online)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Movie Magic <tickets@mail.shardul.online>
RESEND_REPLY_TO=
APP_BASE_URL=http://43.204.215.123

# Set to 'True' for in-memory mock repository mode (offline local testing/demo).
# Set to 'False' to connect to live DynamoDB tables in ap-south-1.
USE_AWS_MOCK=True
